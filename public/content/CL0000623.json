  "claims": [
   {
    "field": "function",
    "value": "Its granules release perforin, which punches pores in an infected cell's membrane, and granzymes, protein-digesting enzymes that pass through those pores and trigger the cell's apoptosis.",
    "quote": "The granules of the NK cells release perforins and granzymes. A perforin is a protein that forms pores in the membranes of infected cells. A granzyme is a protein-digesting enzyme that enters the cell via the perforin pores and triggers apoptosis intracellularly.",
    "source": {
     "section": "21.2 Barrier Defenses and the Innate Immune Response",
     "url": "https://openstax.org/books/anatomy-and-physiology-2e/pages/21-2-barrier-defenses-and-the-innate-immune-response",
     "license": "CC BY 4.0",
     "citation": "Betts JG, Young KA, Wise JA, Johnson E, Poe B, Kruse DH, Korol O, Johnson JE, Womble M, DeSaix P (2022). Anatomy and Physiology 2e. OpenStax.",
     "access": "Access for free at https://openstax.org/books/anatomy-and-physiology-2e/pages/1-introduction"
    }
   },
   {
    "field": "function",
    "value": "Germline-encoded activating receptors let it kill many kinds of target cells spontaneously, without prior antigenic activation, and it also regulates immune responses by releasing cytokines and by direct contact with other cells.",
    "quote": "A lymphocyte that can spontaneously kill a variety of target cells without prior antigenic activation via germline encoded activation receptors and also regulate immune responses via cytokine release and direct contact with other cells.",
    "source": {
     "section": "CL:0000623 natural killer cell",
     "url": "http://purl.obolibrary.org/obo/CL_0000623",
     "license": "CC BY 4.0",
     "citation": "Cell Ontology (CL), https://obofoundry.org/ontology/cl.html"
    }
   }
  ]
