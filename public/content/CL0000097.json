  "claims": [
   {
    "field": "granules",
    "value": "histamine and heparin granules; look: unknown; abundance: many; position: unknown",
    "quote": "The mast cell, found in connective tissue proper, has many cytoplasmic granules. These granules contain the chemical signals histamine and heparin.",
    "source": {
     "section": "4.3 Connective Tissue Supports and Protects",
     "url": "https://openstax.org/books/anatomy-and-physiology-2e/pages/4-3-connective-tissue-supports-and-protects",
     "license": "CC BY 4.0",
     "citation": "Betts JG, Young KA, Wise JA, Johnson E, Poe B, Kruse DH, Korol O, Johnson JE, Womble M, DeSaix P (2022). Anatomy and Physiology 2e. OpenStax.",
     "access": "Access for free at https://openstax.org/books/anatomy-and-physiology-2e/pages/1-introduction"
    }
   },
   {
    "field": "granules",
    "value": "basophilic granules; look: basophilic; abundance: many; position: unknown",
    "quote": "A cell that is found in almost all tissues containing numerous basophilic granules and capable of releasing large amounts of histamine and heparin upon activation.",
    "source": {
     "section": "CL:0000097 mast cell",
     "url": "http://purl.obolibrary.org/obo/CL_0000097",
     "license": "CC BY 4.0",
     "citation": "Cell Ontology (CL), https://obofoundry.org/ontology/cl.html"
    }
   },
   {
    "field": "special",
    "value": "IgE-specific Fc receptors on the cell surface",
    "quote": "its Fc region binds strongly to an IgE-specific Fc receptor on the surfaces of mast cells",
    "source": {
     "section": "21.4 The Adaptive Immune Response: B-lymphocytes and Antibodies",
     "url": "https://openstax.org/books/anatomy-and-physiology-2e/pages/21-4-the-adaptive-immune-response-b-lymphocytes-and-antibodies",
     "license": "CC BY 4.0",
     "citation": "Betts JG, Young KA, Wise JA, Johnson E, Poe B, Kruse DH, Korol O, Johnson JE, Womble M, DeSaix P (2022). Anatomy and Physiology 2e. OpenStax.",
     "access": "Access for free at https://openstax.org/books/anatomy-and-physiology-2e/pages/1-introduction"
    }
   },
   {
    "field": "function",
    "value": "Mast cells keep histamine and heparin in their granules and, when irritated or damaged, release the histamine, which dilates blood vessels and increases blood flow at a site of injury or infection.",
    "quote": "These granules contain the chemical signals histamine and heparin. When irritated or damaged, mast cells release histamine, an inflammatory mediator, which causes vasodilation and increased blood flow at a site of injury or infection",
    "source": {
     "section": "4.3 Connective Tissue Supports and Protects",
     "url": "https://openstax.org/books/anatomy-and-physiology-2e/pages/4-3-connective-tissue-supports-and-protects",
     "license": "CC BY 4.0",
     "citation": "Betts JG, Young KA, Wise JA, Johnson E, Poe B, Kruse DH, Korol O, Johnson JE, Womble M, DeSaix P (2022). Anatomy and Physiology 2e. OpenStax.",
     "access": "Access for free at https://openstax.org/books/anatomy-and-physiology-2e/pages/1-introduction"
    }
   },
   {
    "field": "function",
    "value": "When the IgE held on a mast cell binds its antigen, the cell releases histamine and serotonin, and these mediators recruit eosinophils that carry out the allergic response.",
    "quote": "IgE molecules on mast cells bind the antigen via their variable domains and stimulate the mast cell to release the modified amino acids histamine and serotonin; these chemical mediators then recruit eosinophils which mediate allergic responses.",
    "source": {
     "section": "42.4 Disruptions in the Immune System",
     "url": "https://openstax.org/books/biology-2e/pages/42-4-disruptions-in-the-immune-system",
     "license": "CC BY 4.0",
     "citation": "Clark MA, Douglas M, Choi J (2018). Biology 2e. OpenStax.",
     "access": "Access for free at https://openstax.org/books/biology-2e/pages/1-introduction"
    }
   }
  ]
